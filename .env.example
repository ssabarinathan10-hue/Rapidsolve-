# RAPIDSOLVE — Production Environment Configuration Template
# Copy this file to .env and populate with your actual production values.

NODE_ENV=production
PORT=4000
FRONTEND_URL=https://rapidsolve.io

# Admin Authentication
ADMIN_EMAIL=admin@rapidsolve.io
ADMIN_PASSWORD=change_this_to_a_strong_production_password
ADMIN_TOKEN=change_this_to_a_strong_random_secret_token

# Database Path (Optional: defaults to backend/data/rapidsolve.db)
# DB_PATH=/var/data/rapidsolve.db
